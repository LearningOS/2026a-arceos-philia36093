{
  "name": "ArceOS",
  "image": "docker.io/1301182193/arceos-env:latest",
  "runArgs": [
    "--platform=linux/amd64",
    "--hostname=arceos"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "containerEnv": {
    "CARGO_TERM_COLOR": "always"
  },
  "postCreateCommand": "rustc --version && cargo --version && qemu-system-riscv64 --version | head -n 1",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ],
      "settings": {
        "rust-analyzer.server.path": "/opt/cargo/bin/rust-analyzer",
        "rust-analyzer.cargo.target": "riscv64gc-unknown-none-elf",
        "rust-analyzer.linkedProjects": ["arceos/Cargo.toml"],
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  }
}
